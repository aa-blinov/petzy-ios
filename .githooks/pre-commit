#!/bin/sh
# Быстрые проверки перед коммитом: форматирование и стиль.
# Полный набор с тестами живёт в pre-push.

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.swift$' || true)

# Один запуск на все файлы, а не по одному на файл: swiftformat стартует
# долго, и пятнадцать запусков подряд превращают хук в помеху.
if [ -n "$STAGED" ]; then
    # shellcheck disable=SC2086
    swiftformat $STAGED --lint || {
        echo "swiftformat --lint нашёл неформатированный код. Поправить:"
        echo "  make format"
        exit 1
    }
fi

swiftlint lint --quiet